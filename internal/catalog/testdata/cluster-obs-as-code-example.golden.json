    },
    "links": [
      {
        "title": "Generated from code — edits here are overwritten",
        "type": "link",
        "icon": "code-branch",
        "tooltip": "",
        "url": "https://github.com/duynhlab/obs-as-code",
        "tags": [],
        "asDropdown": false,
        "targetBlank": true,
        "includeVars": false,
        "keepTime": false
      }
    ],
    "preload": false,
    "tags": [
      "obs-as-code",
      "owner:platform",
      "example",
      "golden-signals"
    ],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-6h",
      "to": "now",
      "autoRefresh": "1m",
      "autoRefreshIntervals": [
        "30s",
        "1m",
        "5m",
        "15m",
        "1h"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "title": "Example — Golden Signals",
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "ds",
          "pluginId": "prometheus",
          "refresh": "never",
          "regex": "",
          "current": {
            "text": "VictoriaMetrics (Prometheus)",
            "value": "VictoriaMetrics (Prometheus)"
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "label": "Datasource",
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": false
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "job",
          "current": {
            "text": "",
            "value": ""
          },
          "label": "Service",
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "${ds}"
            },
            "spec": {
              "expr": "label_values(up, job)"
            }
          },
          "regex": "",
          "regexApplyTo": "value",
          "sort": "alphabeticalAsc",
          "options": [],
          "multi": true,
          "includeAll": true,
          "allowCustomValue": true
        }
      }
    ]
  }
}
