          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Go runtime",
              "layout": {
                "kind": "GridLayout",
                "spec": {
                  "items": [
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 0,
                        "width": 8,
                        "height": 7,
                        "element": {
                          "kind": "ElementReference",
