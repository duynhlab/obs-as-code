{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "obs-as-code-example"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Crosshair",
    "editable": true,
    "elements": {
      "cpu": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "CPU",
          "description": "CPU seconds consumed per second; 1 means one core saturated.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds}"
                      },
                      "spec": {
                        "expr": "sum(rate(process_cpu_seconds_total{job=~\"$job\"}[$__rate_interval])) by (instance)",
                        "legendFormat": "{{instance}}",
                        "range": true
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "gradientMode": "none",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "error-rate": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Error rate",
          "description": "Requests answered with a 5xx, per second. 4xx is the caller's problem and is deliberately absent.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds}"
                      },
                      "spec": {
                        "expr": "sum(rate(http_server_request_duration_seconds_count{job=~\"$job\",http_response_status_code=~\"5..\"}[$__rate_interval])) by (http_route)",
                        "legendFormat": "{{http_route}}",
                        "range": true
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps",
                  "custom": {
                    "gradientMode": "none",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "error-ratio": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Error ratio",
          "description": "Fraction of requests failing. The denominator is guarded with `\u003e 0` so an idle service reports no data rather than NaN.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds}"
                      },
                      "spec": {
                        "expr": "sum(rate(http_server_request_duration_seconds_count{job=~\"$job\",http_response_status_code=~\"5..\"}[$__rate_interval])) / (sum(rate(http_server_request_duration_seconds_count{job=~\"$job\"}[$__rate_interval])) \u003e 0)",
                        "legendFormat": "",
                        "range": true
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "value",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "values": false,
                  "calcs": [
                    "lastNotNull"
                  ]
                },
                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "goroutines": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Goroutines",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds}"
                      },
                      "spec": {
                        "expr": "sum(go_goroutines{job=~\"$job\"}) by (instance)",
                        "legendFormat": "{{instance}}",
                        "range": true
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "gradientMode": "none",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "heap-in-use": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Heap in use",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds}"
                      },
                      "spec": {
                        "expr": "sum(go_memstats_heap_alloc_bytes{job=~\"$job\"}) by (instance)",
                        "legendFormat": "{{instance}}",
                        "range": true
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "decbytes",
                  "custom": {
                    "gradientMode": "none",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "latency-p95": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Latency p95",
          "description": "95th percentile request duration. `le` stays in the inner aggregation, or this returns NaN.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds}"
                      },
                      "spec": {
                        "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])) by (le, http_route))",
                        "legendFormat": "{{http_route}}",
                        "range": true
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "custom": {
                    "gradientMode": "none",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "request-rate": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Request rate",
          "description": "Requests handled per second, by route.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds}"
                      },
                      "spec": {
                        "expr": "sum(rate(http_server_request_duration_seconds_count{job=~\"$job\"}[$__rate_interval])) by (http_route)",
                        "legendFormat": "{{http_route}}",
                        "range": true
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps",
                  "custom": {
                    "gradientMode": "none",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "restarts": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Restarts",
          "description": "Process starts over the selected range.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds}"
                      },
                      "spec": {
                        "expr": "changes(process_start_time_seconds{job=~\"$job\"}[$__range])",
                        "legendFormat": "{{instance}}",
                        "range": true
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "gradientMode": "none",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "targets-up": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Targets up",
          "description": "Scrape health. A board showing nothing is ambiguous until you know whether the target is even up.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds}"
                      },
                      "spec": {
                        "expr": "up{job=~\"$job\"}",
                        "legendFormat": "{{instance}}",
                        "range": true
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "value",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "values": false,
                  "calcs": [
                    "lastNotNull"
                  ]
                },
                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
