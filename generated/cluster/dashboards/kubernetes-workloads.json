                      "spec": {
                        "expr": "sum by (pod) (sum by (namespace, pod) (container_memory_working_set_bytes{job=\"kubelet\",namespace=~\"$namespace\",container!=\"\",image!=\"\"}) * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"})) / (sum by (pod) (label_replace(label_replace(kube_pod_container_resource_limits{job=\"kube-state-metrics\",exported_namespace=~\"$namespace\",resource=\"memory\"}, \"namespace\", \"$1\", \"exported_namespace\", \"(.+)\"), \"pod\", \"$1\", \"exported_pod\", \"(.+)\") * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"})) \u003e 0)",
                        "legendFormat": "{{pod}}",
                        "range": true
