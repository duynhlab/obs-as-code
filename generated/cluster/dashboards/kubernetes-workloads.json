  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "ds",
        "label": "Datasource",
        "skipUrlSync": false,
        "query": "prometheus",
        "current": {
          "text": "VictoriaMetrics (Prometheus)",
          "value": "VictoriaMetrics (Prometheus)"
        },
        "multi": false,
        "allowCustomValue": false,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      },
      {
        "type": "query",
        "name": "namespace",
        "label": "Namespace",
        "skipUrlSync": false,
        "query": "label_values(kube_pod_info, exported_namespace)",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "multi": false,
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      },
      {
        "type": "query",
        "name": "workload_type",
        "label": "Type",
        "skipUrlSync": false,
        "query": "label_values(namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\"}, workload_type)",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
