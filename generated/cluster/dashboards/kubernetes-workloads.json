                      },
                      {
                        "value": 0.8,
                        "color": "yellow"
                      },
                      {
                        "value": 0.9,
                        "color": "red"
                      }
                    ]
                  },
                  "custom": {
                    "gradientMode": "none",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "network-io": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Network I/O by Pod",
          "description": "Pod network throughput for the selected workload. Transmit is drawn below the axis, matching the overview's convention.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds}"
                      },
                      "spec": {
                        "expr": "sum by (pod) (rate(container_network_receive_bytes_total{job=\"kubelet\",namespace=~\"$namespace\",namespace!=\"\"}[$__rate_interval]) * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"}))",
                        "legendFormat": "RX {{pod}}",
                        "range": true
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds}"
                      },
                      "spec": {
                        "expr": "sum by (pod) (rate(container_network_transmit_bytes_total{job=\"kubelet\",namespace=~\"$namespace\",namespace!=\"\"}[$__rate_interval]) * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"}))",
                        "legendFormat": "TX {{pod}}",
                        "range": true
                      }
                    },
                    "refId": "query-1",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
