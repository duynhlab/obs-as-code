{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "kubernetes-workloads"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Crosshair",
    "editable": true,
    "elements": {
      "cpu-by-pod": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "CPU by Pod",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds}"
                      },
                      "spec": {
                        "expr": "sum by (pod) (sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{job=\"kubelet\",namespace=~\"$namespace\",container!=\"\",image!=\"\"}[$__rate_interval])) * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"}))",
                        "legendFormat": "{{pod}}",
                        "range": true
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "gradientMode": "none",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "cpu-by-workload": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "CPU by Workload",
          "description": "CPU cores consumed, attributed to the owning Deployment, StatefulSet, DaemonSet or Job through the ownership recording rule.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds}"
                      },
                      "spec": {
                        "expr": "sum by (workload, workload_type) (sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{job=\"kubelet\",namespace=~\"$namespace\",container!=\"\",image!=\"\"}[$__rate_interval])) * on (namespace, pod) group_left (workload, workload_type) (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"}))",
                        "legendFormat": "{{workload_type}}/{{workload}}",
                        "range": true
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "gradientMode": "none",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never",
                    "stacking": {
                      "mode": "normal"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "cpu-throttling": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "CPU Throttling by Pod",
          "description": "Fraction of CFS periods throttled, for the selected workload's pods. Healthy pods stay visible at zero rather than being filtered away.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds}"
                      },
                      "spec": {
                        "expr": "sum by (pod) (rate(container_cpu_cfs_throttled_periods_total{job=\"kubelet\",namespace=~\"$namespace\",container!=\"\"}[$__rate_interval]) * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"})) / clamp_min(sum by (pod) (rate(container_cpu_cfs_periods_total{job=\"kubelet\",namespace=~\"$namespace\",container!=\"\"}[$__rate_interval]) * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"})), 1)",
                        "legendFormat": "{{pod}}",
                        "range": true
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 0.25,
                        "color": "yellow"
                      },
                      {
                        "value": 0.5,
                        "color": "red"
                      }
                    ]
                  },
                  "custom": {
                    "gradientMode": "none",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "cpu-vs-requests": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "CPU Usage vs Requests by Pod",
          "description": "Usage as a fraction of requests. Above 1 is legitimate burst; sustained far below 1 is over-provisioning that inflates the scheduling gauges on the overview.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds}"
                      },
                      "spec": {
                        "expr": "sum by (pod) (sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{job=\"kubelet\",namespace=~\"$namespace\",container!=\"\",image!=\"\"}[$__rate_interval])) * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"})) / (sum by (pod) (label_replace(label_replace(kube_pod_container_resource_requests{job=\"kube-state-metrics\",exported_namespace=~\"$namespace\",resource=\"cpu\"}, \"namespace\", \"$1\", \"exported_namespace\", \"(.+)\"), \"pod\", \"$1\", \"exported_pod\", \"(.+)\") * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"})) \u003e 0)",
                        "legendFormat": "{{pod}}",
                        "range": true
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit",
                  "min": 0,
                  "custom": {
                    "gradientMode": "none",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "memory-by-pod": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Memory by Pod",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds}"
                      },
                      "spec": {
                        "expr": "sum by (pod) (sum by (namespace, pod) (container_memory_working_set_bytes{job=\"kubelet\",namespace=~\"$namespace\",container!=\"\",image!=\"\"}) * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"}))",
                        "legendFormat": "{{pod}}",
                        "range": true
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "decbytes",
                  "custom": {
                    "gradientMode": "none",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "memory-by-workload": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Memory by Workload",
          "description": "Working-set memory by workload — the figure the OOM killer acts on.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
