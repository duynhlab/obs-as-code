      "memory-vs-limits": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Memory Usage vs Limits by Pod",
          "description": "Working set as a fraction of the memory limit — 1.0 is where the OOM killer lives. Same join shape as homelab's KubePodMemoryNearLimit alert, so the panel and the page agree.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds}"
