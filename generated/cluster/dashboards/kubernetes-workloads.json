{
  "uid": "kubernetes-workloads",
  "title": "Kubernetes Workloads",
  "tags": [
    "obs-as-code",
    "owner:platform",
    "kubernetes",
    "workloads"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "hidden": false,
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "fiscalYearStartMonth": 0,
  "refresh": "1m",
  "schemaVersion": 42,
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "title": "Workloads in $namespace",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (workload, workload_type) (sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{job=\"kubelet\",namespace=~\"$namespace\",container!=\"\",image!=\"\"}[$__rate_interval])) * on (namespace, pod) group_left (workload, workload_type) (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"}))",
          "instant": false,
          "legendFormat": "{{workload_type}}/{{workload}}",
          "range": true
        }
      ],
      "title": "CPU by Workload",
      "description": "CPU cores consumed, attributed to the owning Deployment, StatefulSet, DaemonSet or Job through the ownership recording rule.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "gradientMode": "none",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (workload, workload_type) (sum by (namespace, pod) (container_memory_working_set_bytes{job=\"kubelet\",namespace=~\"$namespace\",container!=\"\",image!=\"\"}) * on (namespace, pod) group_left (workload, workload_type) (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"}))",
          "instant": false,
          "legendFormat": "{{workload_type}}/{{workload}}",
          "range": true
        }
      ],
      "title": "Memory by Workload",
      "description": "Working-set memory by workload — the figure the OOM killer acts on.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "min": 0,
          "custom": {
            "gradientMode": "none",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (workload, workload_type) (sum by (namespace, pod) (label_replace(label_replace(rate(kube_pod_container_status_restarts_total{job=\"kube-state-metrics\",exported_namespace=~\"$namespace\"}[$__rate_interval]), \"namespace\", \"$1\", \"exported_namespace\", \"(.+)\"), \"pod\", \"$1\", \"exported_pod\", \"(.+)\")) * on (namespace, pod) group_left (workload, workload_type) (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"}))",
          "instant": false,
          "legendFormat": "{{workload_type}}/{{workload}}",
          "range": true
        }
      ],
      "title": "Restarts by Workload",
      "description": "Container restarts per second, attributed to the owning workload.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "gradientMode": "none",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "CPU",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (pod) (sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{job=\"kubelet\",namespace=~\"$namespace\",container!=\"\",image!=\"\"}[$__rate_interval])) * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"}))",
          "instant": false,
          "legendFormat": "{{pod}}",
          "range": true
        }
      ],
      "title": "CPU by Pod",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "gradientMode": "none",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (pod) (sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{job=\"kubelet\",namespace=~\"$namespace\",container!=\"\",image!=\"\"}[$__rate_interval])) * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"})) / (sum by (pod) (label_replace(label_replace(kube_pod_container_resource_requests{job=\"kube-state-metrics\",exported_namespace=~\"$namespace\",resource=\"cpu\"}, \"namespace\", \"$1\", \"exported_namespace\", \"(.+)\"), \"pod\", \"$1\", \"exported_pod\", \"(.+)\") * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"})) \u003e 0)",
          "instant": false,
          "legendFormat": "{{pod}}",
          "range": true
        }
      ],
      "title": "CPU Usage vs Requests by Pod",
      "description": "Usage as a fraction of requests. Above 1 is legitimate burst; sustained far below 1 is over-provisioning that inflates the scheduling gauges on the overview.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "gradientMode": "none",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (pod) (rate(container_cpu_cfs_throttled_periods_total{job=\"kubelet\",namespace=~\"$namespace\",container!=\"\"}[$__rate_interval]) * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"})) / clamp_min(sum by (pod) (rate(container_cpu_cfs_periods_total{job=\"kubelet\",namespace=~\"$namespace\",container!=\"\"}[$__rate_interval]) * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"})), 1)",
          "instant": false,
          "legendFormat": "{{pod}}",
          "range": true
        }
      ],
      "title": "CPU Throttling by Pod",
      "description": "Fraction of CFS periods throttled, for the selected workload's pods. Healthy pods stay visible at zero rather than being filtered away.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.25,
                "color": "yellow"
              },
              {
                "value": 0.5,
                "color": "red"
              }
            ]
          },
          "custom": {
            "gradientMode": "none",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "Memory",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (pod) (sum by (namespace, pod) (container_memory_working_set_bytes{job=\"kubelet\",namespace=~\"$namespace\",container!=\"\",image!=\"\"}) * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"}))",
          "instant": false,
          "legendFormat": "{{pod}}",
          "range": true
        }
      ],
      "title": "Memory by Pod",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "min": 0,
          "custom": {
            "gradientMode": "none",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (pod) (sum by (namespace, pod) (container_memory_working_set_bytes{job=\"kubelet\",namespace=~\"$namespace\",container!=\"\",image!=\"\"}) * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"})) / (sum by (pod) (label_replace(label_replace(kube_pod_container_resource_limits{job=\"kube-state-metrics\",exported_namespace=~\"$namespace\",resource=\"memory\"}, \"namespace\", \"$1\", \"exported_namespace\", \"(.+)\"), \"pod\", \"$1\", \"exported_pod\", \"(.+)\") * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"})) \u003e 0)",
          "instant": false,
          "legendFormat": "{{pod}}",
          "range": true
        }
      ],
      "title": "Memory Usage vs Limits by Pod",
      "description": "Working set as a fraction of the memory limit — 1.0 is where the OOM killer lives. Same join shape as homelab's KubePodMemoryNearLimit alert, so the panel and the page agree.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.8,
                "color": "yellow"
              },
              {
                "value": 0.9,
                "color": "red"
              }
            ]
          },
          "custom": {
            "gradientMode": "none",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "Network",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (pod) (rate(container_network_receive_bytes_total{job=\"kubelet\",namespace=~\"$namespace\",namespace!=\"\"}[$__rate_interval]) * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"}))",
          "instant": false,
          "legendFormat": "RX {{pod}}",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (pod) (rate(container_network_transmit_bytes_total{job=\"kubelet\",namespace=~\"$namespace\",namespace!=\"\"}[$__rate_interval]) * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"}))",
          "instant": false,
          "legendFormat": "TX {{pod}}",
          "range": true
        }
      ],
      "title": "Network I/O by Pod",
      "description": "Pod network throughput for the selected workload. Transmit is drawn below the axis, matching the overview's convention.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "gradientMode": "none",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "TX.*"
            },
            "properties": [
              {
                "id": "custom.transform",
                "value": "negative-Y"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "Health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (pod) (sum by (namespace, pod) (label_replace(label_replace(rate(kube_pod_container_status_restarts_total{job=\"kube-state-metrics\",exported_namespace=~\"$namespace\"}[$__rate_interval]), \"namespace\", \"$1\", \"exported_namespace\", \"(.+)\"), \"pod\", \"$1\", \"exported_pod\", \"(.+)\")) * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"}))",
          "instant": false,
          "legendFormat": "{{pod}}",
          "range": true
        }
      ],
      "title": "Restarts by Pod",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "gradientMode": "none",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (pod, reason) (label_replace(label_replace(kube_pod_container_status_waiting_reason{job=\"kube-state-metrics\",exported_namespace=~\"$namespace\"}, \"namespace\", \"$1\", \"exported_namespace\", \"(.+)\"), \"pod\", \"$1\", \"exported_pod\", \"(.+)\") * on (namespace, pod) group_left () (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\",workload_type=~\"$workload_type\",workload=~\"$workload\"}))",
          "instant": false,
          "legendFormat": "{{pod}} · {{reason}}",
          "range": true
        }
      ],
      "title": "Containers Waiting by Reason",
      "description": "Containers stuck waiting — CrashLoopBackOff, ImagePullBackOff, CreateContainerConfigError. Zero for every pod is the healthy state.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
