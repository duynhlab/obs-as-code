                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "Bps",
                  "custom": {
                    "gradientMode": "none",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never"
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "TX.*"
                    },
                    "properties": [
                      {
                        "id": "custom.transform",
                        "value": "negative-Y"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
